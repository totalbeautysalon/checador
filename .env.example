# Configuración del Checador de Asistencia - Total Beauty

# URL del Checador (Puerto 3333 por defecto)
NEXTAUTH_URL="http://localhost:3333"

# Clave secreta para cifrado de sesiones NextAuth (puedes generar una con `openssl rand -base64 32`)
NEXTAUTH_SECRET="super-secret-key-change-me-in-production"

# Bypass TLS para conexiones de red locales estrictas con antivirus (opcional, 0 = activado)
NODE_TLS_REJECT_UNAUTHORIZED=0
